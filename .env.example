# ==============================================================================
# POLICE SI RECRUITMENT & PRACTICE PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Frontend Port: Defaults to 3000
PORT=3000

# Backend API Configuration:
# Leave as '/api/v1' to use the built-in Next.js REST API routes.
# Or point to your external Node.js / Express / Go / Django server:
# e.g.: NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Security & Session Settings
NEXT_PUBLIC_SESSION_TIMEOUT_MINS=60
JWT_SECRET=super_secret_police_si_recruitment_jwt_key_2026_tslprb_ap
JWT_EXPIRY_DAYS=7d

# Database Connection (PostgreSQL - Prisma / SQL)
DATABASE_URL="postgresql://postgres:police_si_admin_2026@localhost:5432/police_si_db?schema=public"

# AWS S3 / Supabase Storage (For Descriptive handwritten answer sheets & Profile photos)
STORAGE_PROVIDER=supabase
STORAGE_BUCKET_NAME=police-si-descriptive-papers
STORAGE_ENDPOINT=https://your-project.supabase.co/storage/v1
STORAGE_API_KEY=your_supabase_or_aws_s3_key_here

# Payment Gateway (Razorpay / BillDesk / Cashfree)
RAZORPAY_KEY_ID=rzp_live_police_si_key
RAZORPAY_KEY_SECRET=rzp_live_secret_tslprb

// Prisma Database Schema for Police SI Recruitment Platform
// Modeled directly from PRD Section 6 (High-Level SQL Database Schema)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  STUDENT
  ADMIN
  CONTENT_CREATOR
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

enum TargetState {
  TELANGANA
  ANDHRA_PRADESH
  ALL_INDIA
}

enum ExamType {
  PRELIMS_PWT
  MAINS_PAPER_1_ENGLISH
  MAINS_PAPER_2_REGIONAL
  MAINS_PAPER_3_ARITHMETIC_REASONING
  MAINS_PAPER_4_GENERAL_STUDIES
  DAILY_QUIZ
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  PAUSED
  FLAGGED_CHEATING
}

enum PetEventType {
  RUN_1600M
  RUN_800M
  SPRINT_100M
  LONG_JUMP
  SHOT_PUT
}

model User {
  id               String           @id @default(uuid())
  name             String
  email            String           @unique
  phone            String           @unique
  passwordHash     String?
  role             UserRole         @default(STUDENT)
  targetState      TargetState      @default(TELANGANA)
  targetExam       String           @default("TSLPRB_SI_CIVIL_AR")
  primaryLanguage  String           @default("TELUGU")
  gender           String           @default("MALE")
  subscriptionTier SubscriptionTier @default(FREE)
  rollNumber       String           @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  attempts               UserAttempt[]
  petLogs                PetLog[]
  descriptiveSubmissions DescriptiveSubmission[]

  @@index([role, targetState])
}

model Question {
  id                  String   @id @default(uuid())
  subject             String
  topic               String
  questionText        String
  questionTextTelugu  String?
  options             Json     // [{ key: 'A', text: '...', textTelugu: '...' }]
  correctAnswer       String   // 'A' | 'B' | 'C' | 'D'
  explanation         String
  explanationTelugu   String?
  difficulty          String   @default("MEDIUM")
  marks               Float    @default(1.0)
  negativeMarks       Float    @default(0.25)
  createdAt           DateTime @default(now())

  examQuestions  ExamQuestion[]
  attemptAnswers AttemptAnswer[]

  @@index([subject, topic])
}

model Exam {
  id                 String   @id @default(uuid())
  title              String
  titleTelugu        String?
  examType           ExamType
  durationMins       Int      @default(180)
  totalMarks         Float    @default(200.0)
  totalQuestions     Int      @default(200)
  negativeMarking    Boolean  @default(true)
  negativeMarkRate   Float    @default(0.25)
  isBilingual        Boolean  @default(true)
  targetState        TargetState @default(TELANGANA)
  isPremiumOnly      Boolean  @default(false)
  createdAt          DateTime @default(now())

  examQuestions ExamQuestion[]
  attempts      UserAttempt[]
}

model ExamQuestion {
  id          String   @id @default(uuid())
  examId      String
  questionId  String
  sectionName String   @default("General")
  orderIndex  Int      @default(0)

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
  @@index([examId])
}

model UserAttempt {
  id               String        @id @default(uuid())
  userId           String
  examId           String
  score            Float         @default(0.0)
  totalMarks       Float         @default(200.0)
  accuracy         Float         @default(0.0)
  timeSpentSeconds Int           @default(0)
  status           AttemptStatus @default(IN_PROGRESS)
  startedAt        DateTime      @default(now())
  completedAt      DateTime?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam    Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers AttemptAnswer[]

  @@index([userId, examId])
}

model AttemptAnswer {
  id                String   @id @default(uuid())
  attemptId         String
  questionId        String
  selectedOption    String?  // 'A', 'B', 'C', 'D'
  timeTakenSeconds  Int      @default(0)
  isCorrect         Boolean  @default(false)
  markedForReview   Boolean  @default(false)

  attempt  UserAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

model PetLog {
  id          String       @id @default(uuid())
  userId      String
  eventType   PetEventType
  metricValue Float        // Seconds or Meters
  unit        String       // 'seconds' or 'meters'
  loggedDate  DateTime     @default(now())
  isQualified Boolean      @default(false)
  notes       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, eventType])
}

model DescriptiveSubmission {
  id               String   @id @default(uuid())
  userId           String
  candidateName    String
  candidateRoll    String
  paperType        String   // 'PAPER_I_ENGLISH', 'PAPER_II_TELUGU'
  topic            String
  typedContent     String?  @db.Text
  scannedImageUrl  String?
  submittedAt      DateTime @default(now())
  status           String   @default("PENDING_REVIEW") // PENDING_REVIEW, EVALUATED
  marksAwarded     Float?
  maxMarks         Float    @default(50.0)
  evaluatorRemarks String?  @db.Text
  rubricScores     Json?    // { contentRelevance: 12, vocabularyGrammar: 12, ... }

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}
